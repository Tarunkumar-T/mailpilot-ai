# MailPilot Environment Variables

# Gmail OAuth 2.0 Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# OAuth Session Secret
NEXTAUTH_SECRET="a_random_32_character_secret_key_here"

# AI Model Provider (Gemini / OpenAI compatible)
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Real-Time Google Cloud Pub/Sub Webhook Verification Secret
GMAIL_PUSH_SECRET="mailpilot-push-verification-token"

# Optional SMTP fallback credentials (for test environments)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="app-password"
